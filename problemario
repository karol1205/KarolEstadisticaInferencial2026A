      "source": [
        "4. Los estudiantes que obtienen calificaciones más altas en los exámenes cortos tienden a obtener también calificaciones finales más altas"
      ],
      "metadata": {
        "id": "AKpLWaxMkvY5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from scipy.stats import pearsonr\n",
        "\n",
        "# Test de Pearson\n",
        "# H0: rho = 0     (No hay correlación)\n",
        "# H1: rho ≠ 0     (Sí hay correlación)\n",
        "# alpha = 0.05\n",
        "\n",
        "r, valor_p = pearsonr(x, y)\n",
        "\n",
        "print(f\"Coeficiente de correlación: {r: 0.4f}\")\n",
        "print(f'Valor p: {valor_p: 0.4f}')"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "T0hQiI02rFsg",
        "outputId": "fa1ccdfb-a943-4a00-f302-b61ca9f1850c"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Coeficiente de correlación:  0.8646\n",
            "Valor p:  0.0000\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import statsmodels.api as sm\n",
        "x_constante = sm.add_constant(x)\n",
        "modelo = sm.OLS(y, x_constante).fit()\n",
        "y_calculada = modelo.predict(x_constante)\n",
        "\n",
        "modelo.params"
